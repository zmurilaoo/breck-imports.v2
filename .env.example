# Variáveis da loja (cadastrar na Vercel; nunca commitar valores reais)

# Mercado Pago
MP_ACCESS_TOKEN=            # segredo (servidor). TEST-... no Preview, APP_USR-... em Production
MP_WEBHOOK_SECRET=          # segredo do webhook (painel MP > Webhooks)
VITE_MP_PUBLIC_KEY=         # public key (não é segredo; entra no build). TEST-... no Preview, APP_USR-... em Production

# E-mail transacional (Resend)
RESEND_API_KEY=             # segredo. Sem ela, os e-mails só aparecem no log
LOJA_EMAIL_REMETENTE=       # ex.: Breck Imports <pedidos@breckimports.com.br> (domínio verificado no Resend)
LOJA_EMAIL=                 # reply-to e contato

# SuperFrete
SUPERFRETE_TOKEN=
SUPERFRETE_CEP_ORIGEM=
SUPERFRETE_SANDBOX=
SUPERFRETE_AUTO_PAY=
SUPERFRETE_AUTO_PAY_MAX=
SUPERFRETE_PESO_PAR_KG=
SUPERFRETE_REMETENTE_NOME=
SUPERFRETE_REMETENTE_ENDERECO=
SUPERFRETE_REMETENTE_NUMERO=
SUPERFRETE_REMETENTE_COMPLEMENTO=
SUPERFRETE_REMETENTE_BAIRRO=
SUPERFRETE_REMETENTE_CIDADE=
SUPERFRETE_REMETENTE_UF=
SUPERFRETE_REMETENTE_DOCUMENTO=

# Banco de pedidos (Upstash via integração da Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

SITE_URL=
